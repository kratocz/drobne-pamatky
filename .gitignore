# macOS
.DS_Store
._*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*

# Lokální buildy
dist/
build/

# Citlivá data (DB dumpy z VPS, credentials)
*.sql
*.sql.gz
.env
.env.local

# Generované thumbnaily (AVIF 250 q50) – generuje scripts/snapshot/build_thumbnails.py
# Lokální vývoj, později commitnout pro Pages deploy
/data/thumbs/

# Detail JSONy (319 MB, 81 735 souborů) - lokálně generované, pro Pages deploy se musí
# rozhodnout zda commit (zvětší repo) nebo deploy přes Actions z out/
/data/details/

# Pre-built search index (14 MB) - generuje scripts/snapshot/build_search_index.js
# Stejné dilema jako details/ - zatím gitignore
/data/search-index.json

# Per-pamatka HTML + sitemap (~222 MB, 82k souborů) - generuje scripts/snapshot/build_static_pages.py
# Lokálně produkované, deploy.sh kopíruje na gh-pages root
# Pozn.: cesty v repo ROOT (ne v data/), protože URL struktura má /pamatka/... a /sitemap.xml.
/pamatka/
/sitemap.xml
/sitemap-*.xml
/robots.txt

# Master GeoJSON + lookups (~8 MB + ~80 KB) - generuje scripts/snapshot/export.py
# Lokálně produkované sync-from-source.sh; gh-pages deploy je kopíruje samostatně
/data/pamatky.geojson
/data/lookups.json
# Exception: thumbs-manifest patří do gitu — sync-from-source.sh ho potřebuje jako diff base
!/data/thumbs-manifest.json

# Visual companion (brainstorming mockups)
.superpowers/

# Playwright MCP (browser automation artefakty)
.playwright-mcp/
