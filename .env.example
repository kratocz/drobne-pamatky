# Šablona pro .env – zkopíruj na .env a doplň hodnoty (`cp .env.example .env && chmod 600 .env`).
# .env nikdy necommitovat (je v .gitignore).
#
# DB credentials starého serveru drobnepamatky.cz (Drupal 6, MySQL kontejner www_mysql_1).
# Zdroj pravdy: /www/drobnepamatky.cz/www/sites/default/settings.php (proměnná $db_url).
#
# Přístup zvenčí pouze přes SSH tunel:
#   ssh -L 3307:127.0.0.1:3306 root@drobnepamatky.cz
# Pak lokálně:
#   set -a; source .env; set +a
#   mysql -h 127.0.0.1 -P "$OLD_DB_PORT" -u "$OLD_DB_USER" -p"$OLD_DB_PASSWORD" "$OLD_DB_NAME"

OLD_DB_HOST=
OLD_DB_PORT=
OLD_DB_USER=
OLD_DB_PASSWORD=
OLD_DB_NAME=

# Cloudflare Web Analytics beacon token (public, ne secret — vázaný na hostname).
# Získat: dash.cloudflare.com → Web Analytics → Add site → beacon token (32-hex).
# Prázdné = bez analytiky (fork-friendly). V CI nastav jako GitHub variable:
#   gh variable set CF_BEACON_TOKEN --body "<token>"
CF_BEACON_TOKEN=
